const { Client, GatewayIntentBits, REST, Routes, SlashCommandBuilder } = require('discord.js');
const axios = require('axios');

// Lấy Token và Client ID từ biến môi trường trên Render (đã cấu hình an toàn)
const TOKEN = process.env.DISCORD_TOKEN;
const CLIENT_ID = process.env.CLIENT_ID;

// API Key Bacon Bypass của bạn
const BACON_API_KEY = 'Bacon-55557549e001fbfe3f75-19acd0c4529a899fe7b4';

// Khởi tạo client cho Discord Bot
const client = new Client({
    intents: [GatewayIntentBits.Guilds]
});

// Đăng ký lệnh slash /bypass
const commands = [
    new SlashCommandBuilder()
        .setName('bypass')
        .setDescription('Tự động bypass link bằng Bacon API của bạn')
        .addStringOption(option =>
            option.setName('url')
                .setDescription('Link cần bypass')
                .setRequired(true))
].map(command => command.toJSON());

const rest = new REST({ version: '10' }).setToken(TOKEN);

(async () => {
    try {
        console.log('Đang đăng ký lệnh slash cho bot...');
        await rest.put(Routes.applicationCommands(CLIENT_ID), { body: commands });
        console.log('Đăng ký lệnh thành công!');
    } catch (error) {
        console.error('Lỗi đăng ký lệnh:', error);
    }
})();

client.once('ready', () => {
    console.log(`Bot đã sẵn sàng online với tên: ${client.user.tag}`);
});

// Xử lý sự kiện khi người dùng gõ lệnh /bypass
client.on('interactionCreate', async interaction => {
    if (!interaction.isChatInputCommand()) return;

    if (interaction.commandName === 'bypass') {
        const targetUrl = interaction.options.getString('url');
        
        // Phản hồi tạm thời để bot không bị timeout (quá thời gian 3s)
        await interaction.deferReply();

        try {
            // GỌI API ĐẾN SERVER BACON BYPASS
            // Lưu ý: Nhớ kiểm tra lại đường dẫn endpoint chính xác trong API Documentation của họ
            const response = await axios.post('https://baconbypass.online/api/v1/bypass', {
                url: targetUrl
            }, {
                headers: {
                    'Authorization': `Bearer ${BACON_API_KEY}`,
                    'Content-Type': 'application/json'
                }
            });

            const resultData = response.data; 

            await interaction.editReply(`✅ **Bypass thành công!**\nKết quả: \`${JSON.stringify(resultData)}\``);

        } catch (error) {
            console.error(error);
            await interaction.editReply('❌ Đã xảy ra lỗi khi gọi API bypass hoặc link không hợp lệ!');
        }
    }
});

// Khởi chạy bot đăng nhập vào Discord
client.login(TOKEN);
