const { 
    Client, 
    GatewayIntentBits, 
    SlashCommandBuilder, 
    PermissionFlagsBits, 
    ActionRowBuilder, 
    ButtonBuilder, 
    ButtonStyle, 
    AuditLogEvent,
    REST,
    Routes 
} = require('discord.js');
const http = require('http');

const client = new Client({
    intents: [
        GatewayIntentBits.Guilds,
        GatewayIntentBits.GuildModeration,
        GatewayIntentBits.GuildWebhooks,
        GatewayIntentBits.GuildInvites
    ]
});

// Bộ nhớ đệm lưu trữ dữ liệu backup và trạng thái anti-nuke
const serverBackups = new Map();
const antiNukeStatus = new Map();

// Web server giả lập để tích hợp UptimeRobot (Giữ bot luôn online trên Render)
const server = http.createServer((req, res) => {
    res.writeHead(200, { 'Content-Type': 'text/plain' });
    res.end('Massive Anti-Nuke Bot is active!\n');
});
const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
    console.log(`Web server running on port ${PORT}`);
});

client.once('ready', async () => {
    console.log(`Bot đã đăng nhập thành công với tên: ${client.user.tag} (Shard ID: ${client.shard?.id ?? 0})`);

    // Đã xóa quyền mặc định Administrator để ẩn lệnh với mọi người, chỉ Chủ Server mới thấy và dùng được
    const commands = [
        new SlashCommandBuilder()
            .setName('protect-server')
            .setDescription('Kích hoạt quét và bảo vệ server chống nuke'),
        new SlashCommandBuilder()
            .setName('stop')
            .setDescription('Dừng hệ thống chống nuke và xóa dữ liệu bộ nhớ đệm')
    ].map(command => command.toJSON());

    const rest = new REST({ version: '10' }).setToken(process.env.DISCORD_TOKEN);

    try {
        console.log('Đang làm mới các lệnh Slash (/) của ứng dụng...');
        await rest.put(
            Routes.applicationCommands(client.user.id),
            { body: commands },
        );
        console.log('Đã đăng ký thành công các lệnh Slash!');
    } catch (error) {
        console.error('Lỗi khi đăng ký lệnh:', error);
    }
});

// --- HỆ THỐNG LỆNH SLASH (Chỉ Chủ Server thực sự mới gọi được) ---
client.on('interactionCreate', async interaction => {
    if (!interaction.isChatInputCommand()) return;

    if (interaction.commandName === 'protect-server') {
        if (interaction.user.id !== interaction.guild.ownerId) {
            return await interaction.reply({
                content: '❌ **Lỗi:** Chỉ có **Chủ server (Owner)** mới có quyền sử dụng lệnh này!',
                ephemeral: true
            });
        }

        const row = new ActionRowBuilder()
            .addComponents(
                new ButtonBuilder()
                    .setCustomId('antinuke_yes')
                    .setLabel('Yes')
                    .setStyle(ButtonStyle.Success),
                new ButtonBuilder()
                    .setCustomId('antinuke_no')
                    .setLabel('No')
                    .setStyle(ButtonStyle.Danger)
            );

        await interaction.reply({
            content: '🛡️ **ANTI-NUKE SYSTEM:** Do you want the bot to scan and memorize all channels, roles, and webhooks of this server?',
            components: [row],
            ephemeral: true
        });
    }

    if (interaction.commandName === 'stop') {
        if (interaction.user.id !== interaction.guild.ownerId) {
            return await interaction.reply({
                content: '❌ **Lỗi:** Chỉ có **Chủ server (Owner)** mới có quyền sử dụng lệnh này!',
                ephemeral: true
            });
        }

        const guildId = interaction.guild.id;
        if (serverBackups.has(guildId) || antiNukeStatus.get(guildId)) {
            serverBackups.delete(guildId);
            antiNukeStatus.set(guildId, false);
            await interaction.reply({
                content: '🛑 **Anti-Nuke system stopped and all cached server data has been cleared!**',
                ephemeral: true
            });
        } else {
            await interaction.reply({
                content: '⚠️ Anti-Nuke system is not currently active on this server.',
                ephemeral: true
            });
        }
    }
});

// --- XỬ LÝ NÚM BẤM (BUTTON) ---
client.on('interactionCreate', async interaction => {
    if (!interaction.isButton()) return;

    if (interaction.customId === 'antinuke_yes') {
        const guild = interaction.guild;
        const guildId = guild.id;

        await interaction.deferUpdate();

        try {
            const rolesData = guild.roles.cache
                .filter(role => !role.managed && role.id !== guild.id)
                .sort((a, b) => b.position - a.position)
                .map(role => ({
                    name: role.name,
                    color: role.color,
                    permissions: role.permissions.bitfield.toString(),
                    hoist: role.hoist,
                    mentionable: role.mentionable
                }));

            const channelsData = guild.channels.cache.map(channel => ({
                name: channel.name,
                type: channel.type,
                parentId: channel.parentId,
                position: channel.position,
                topic: channel.topic || '',
                nsfw: channel.nsfw || false
            }));

            const fetchedWebhooks = await guild.fetchWebhooks();
            const webhooksData = fetchedWebhooks.map(wh => ({
                name: wh.name,
                channelId: wh.channelId
            }));

            serverBackups.set(guildId, { roles: rolesData, channels: channelsData, webhooks: webhooksData });
            antiNukeStatus.set(guildId, true);

            await interaction.editReply({
                content: `✅ **Successfully scanned and cached!**\n- Roles: ${rolesData.length}\n- Channels: ${channelsData.length}\n- Webhooks: ${webhooksData.length}\n🚀 Ready to protect the server!`,
                components: []
            });
        } catch (error) {
            console.error(error);
            await interaction.editReply({
                content: '❌ Error scanning data. Make sure the bot has Administrator permission!',
                components: []
            });
        }
    } else if (interaction.customId === 'antinuke_no') {
        await interaction.update({
            content: '❌ **Cancelled.** The bot will not cache any data.',
            components: []
        });
    }
});

// --- HÀM KHÓA KHẨN CẤP (Tạm dừng lời mời & Xóa link) ---
async function triggerEmergencyLockdown(guild, reasonText) {
    try {
        await guild.disableInvites(true).catch(() => {});
        const invites = await guild.invites.fetch().catch(() => null);
        if (invites) {
            for (const [code, invite] of invites) {
                await invite.delete(`Anti-Nuke Lockdown: ${reasonText}`).catch(() => {});
            }
        }
    } catch (err) {
        console.error('Error during emergency lockdown:', err);
    }
}

// 1. Kiểm soát Webhook (Chặn app bot / người lạ tạo webhook trái phép)
client.on('webhookUpdate', async (channel) => {
    const guild = channel.guild;
    const guildId = guild.id;
    if (!antiNukeStatus.get(guildId)) return;

    try {
        const auditLogs = await guild.fetchAuditLogs({ limit: 1, type: AuditLogEvent.WebhookCreate });
        const webhookLog = auditLogs.entries.first();
        if (!webhookLog) return;

        const { executor } = webhookLog;
        if (executor && executor.id !== guild.ownerId && executor.id !== client.user.id) {
            const webhooks = await channel.fetchWebhooks();
            const targetWebhook = webhooks.find(wh => wh.owner && wh.owner.id === executor.id);
            if (targetWebhook) await targetWebhook.delete('Anti-Nuke: Unauthorized Webhook creation');

            const member = await guild.members.fetch(executor.id).catch(() => null);
            if (member && member.bannable) {
                await member.ban({ reason: 'Anti-Nuke: Unauthorized Webhook creation' });
            }
            await triggerEmergencyLockdown(guild, 'Unauthorized Webhook detected');
        }
    } catch (err) {
        console.error('Webhook check error:', err);
    }
});

// 2. Chống Spam Tạo Kênh (Phát hiện ai/bot spam tạo nhiều kênh giống nhau -> Ban ngay và xóa sạch kênh rác)
client.on('channelCreate', async (newChannel) => {
    const guild = newChannel.guild;
    const guildId = guild.id;
    if (!antiNukeStatus.get(guildId)) return;

    try {
        const auditLogs = await guild.fetchAuditLogs({ limit: 1, type: AuditLogEvent.ChannelCreate });
        const logEntry = auditLogs.entries.first();
        if (!logEntry) return;

        const { executor } = logEntry;
        if (!executor || executor.id === guild.ownerId || executor.id === client.user.id) return;

        const channelName = newChannel.name;
        const duplicateChannels = guild.channels.cache.filter(c => c.name === channelName);
        
        // Cứ phát hiện dấu hiệu spam tạo từ 3 kênh trùng tên trở lên là xử lý lập tức
        if (duplicateChannels.size >= 3) {
            const member = await guild.members.fetch(executor.id).catch(() => null);
            if (member && member.bannable) {
                await member.ban({ reason: 'Anti-Nuke: Spam creating channels' });
            }

            for (const [id, channel] of duplicateChannels) {
                await channel.delete('Anti-Nuke: Cleanup spam channels').catch(() => {});
            }

            await triggerEmergencyLockdown(guild, 'Spam channel creation');
        }
    } catch (err) {
        console.error('Channel create spam check error:', err);
    }
});

// 3. Theo dõi sự kiện Xóa kênh: Chỉ khi xóa SẠCH HẾT KÊNH mới ban, khóa link và khôi phục từ bản backup
client.on('channelDelete', async (deletedChannel) => {
    const guild = deletedChannel.guild;
    const guildId = guild.id;
    if (!antiNukeStatus.get(guildId)) return;

    try {
        const remainingChannels = guild.channels.cache.filter(c => c.id !== deletedChannel.id);
        if (remainingChannels.size > 0) return; // Chưa xóa sạch hết thì bỏ qua

        const auditLogs = await guild.fetchAuditLogs({ limit: 1, type: AuditLogEvent.ChannelDelete });
        const logEntry = auditLogs.entries.first();
        if (!logEntry) return;

        const { executor } = logEntry;
        if (!executor || executor.id === guild.ownerId || executor.id === client.user.id) return;

        // Ban kẻ đã quét sạch server
        const member = await guild.members.fetch(executor.id).catch(() => null);
        if (member && member.bannable) {
            await member.ban({ reason: 'Anti-Nuke: Deleted all channels in the server' });
        }

        // Khóa khẩn cấp toàn bộ link mời
        await triggerEmergencyLockdown(guild, 'Total server channels deletion');

        // Khôi phục lại toàn bộ kênh từ bản backup đã lưu trước đó
        const backupData = serverBackups.get(guildId);
        if (!backupData) return;

        for (const chData of backupData.channels) {
            await guild.channels.create({
                name: chData.name,
                type: chData.type,
                topic: chData.topic,
                nsfw: chData.nsfw,
                position: chData.position,
                reason: 'Anti-Nuke: Auto restore server structure after total deletion'
            }).catch(() => {});
        }

    } catch (err) {
        console.error('Anti-nuke total deletion restore error:', err);
    }
});

client.login(process.env.DISCORD_TOKEN);
