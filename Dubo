-- PHẦN 3.3: HÀM SĂN WOLF BOSS (UNBOUND WEREWOLF)
-- ====================================================================
local function GetWolfBossTarget()
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, enemy in ipairs(enemies:GetChildren()) do
            if string.find(enemy.Name, "Unbound Werewolf") then
                local eHrp = enemy:FindFirstChild("HumanoidRootPart")
                local eHum = enemy:FindFirstChild("Humanoid")
                if eHrp and eHum and eHum.Health > 0 then
                    return enemy
                end
            end
        end
    end
    return nil
end

local function CheckAndFarmWolfBoss()
    local wolfFound = false
    
    pcall(function()
        local wolfPortal = nil
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (string.find(obj.Name, "WolfPortal") or string.find(obj.Name, "WolfTeleport") or string.find(obj.Name, "WerewolfPortal")) then
                wolfPortal = obj
                break
            end
        end
        
        local targetBoss = GetWolfBossTarget()
        if wolfPortal or targetBoss then
            wolfFound = true
            currentStatusText = "Wolf Event Active!"
            
            _G.BossMode = true
            _G.AutoAttack = true
            
            while _G.AutoPumpkin do
                WaitForCharacterAlive()
                targetBoss = GetWolfBossTarget()
                
                if not targetBoss then
                    currentStatusText = "Moving to Wolf Portal..."
                    if wolfPortal and wolfPortal.Parent then
                        topos(wolfPortal.CFrame)
                    end
                    task.wait(1)
                    
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (string.find(obj.Name, "WolfPortal") or string.find(obj.Name, "WolfTeleport") or string.find(obj.Name, "WerewolfPortal")) then
                            wolfPortal = obj
                            break
                        end
                    end
                else
                    currentStatusText = "Kill: Unbound Werewolf"
                    EquipMelee()
                    
                    local bossHrp = targetBoss:FindFirstChild("HumanoidRootPart")
                    local bossHum = targetBoss:FindFirstChild("Humanoid")
                    
                    if bossHrp and bossHum and bossHum.Health > 0 then
                        while targetBoss and targetBoss.Parent and bossHum and bossHum.Health > 0 and _G.AutoPumpkin do
                            local charCheck = LocalPlayer.Character
                            local humCheck = charCheck and charCheck:FindFirstChildOfClass("Humanoid")
                            if not humCheck or humCheck.Health <= 0 then
                                break
                            end
                            
                            topos(bossHrp.CFrame * CFrame.new(0, 15, 0))
                            task.wait(0.015)
                        end
                        
                        if bossHum and bossHum.Health <= 0 then
                            statMobKills = statMobKills + 1
                            break
                        end
                    end
                end
                
                if not GetWolfBossTarget() and not workspace:FindFirstChild("Unbound Werewolf", true) then
                    break
                end
                task.wait(0.5)
            end
            
            _G.BossMode = false
            _G.AutoAttack = false
        end
    end)
    
    return wolfFound
end

