                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        end
                    end
                    
                    task.wait(1)
                else
                    currentStatusText = "Kill: Hellfire Gas"
                    EquipMelee()
                    
                    local gasHrp = targetGas:FindFirstChild("HumanoidRootPart")
                    local gasHum = targetGas:FindFirstChild("Humanoid")
                    
                    if gasHrp and gasHum and gasHum.Health > 0 then
                        while targetGas and targetGas.Parent and gasHum and gasHum.Health > 0 and _G.AutoPumpkin do
                            local charCheck = LocalPlayer.Character
                            local humCheck = charCheck and charCheck:FindFirstChildOfClass("Humanoid")
                            if not humCheck or humCheck.Health <= 0 then
                                break
                            end
                            
                            topos(gasHrp.CFrame * CFrame.new(0, 10, 0))
                            task.wait(0.015)
                        end
                        
                        if gasHum and gasHum.Health <= 0 then
                            statMobKills = statMobKills + 1
                        end
                    end
                    
                    currentStatusText = "Waiting Event End..."
                    _G.AutoAttack = false
                    
                    while workspace:FindFirstChild("HellfireBorder", true) and _G.AutoPumpkin do
                        if GetHellfireGasTarget() then
                            _G.AutoAttack = true
                            break
                        end
                        task.wait(0.5)
                    end
                end
            end
            
            _G.BossMode = false
            _G.AutoAttack = false
        end
    end)
    
    return hellfireFound
end

