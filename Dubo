local function storeAllOwnedFruits()
    pcall(function()
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local character = LocalPlayer.Character
        
        local function processTool(tool)
            if tool and tool:IsA("Tool") and string.find(tool.Name, "Fruit") then
                local originalName = tool:GetAttribute("OriginalName")
                if originalName then
                    if not fruitAttemptCounts[tool] then
                        fruitAttemptCounts[tool] = 0
                    end
                    if fruitAttemptCounts[tool] < 2 then
                        fruitAttemptCounts[tool] = fruitAttemptCounts[tool] + 1
                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StoreFruit", originalName, tool)
                    end
                end
            end
        end

        if backpack then
            for _, tool in pairs(backpack:GetChildren()) do
                processTool(tool)
            end
        end
        
        if character then
            for _, tool in pairs(character:GetChildren()) do
                processTool(tool)
            end
        end
    end)
    
    CleanGachaUI()
    EquipMelee()
end

