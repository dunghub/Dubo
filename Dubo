local function CheckAndPickFruit()
    WaitForCharacterAlive()
    storeAllOwnedFruits()
    local foundFruit = false
    
    pcall(function()
        for _, obj in ipairs(Workspace:GetChildren()) do
            if (obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("BasePart")) and string.find(obj.Name, "Fruit") then
                local uniqueId = obj:GetDebugId()
                
                if not blacklistedFruits[uniqueId] then
                    local handle = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
                    local character = LocalPlayer.Character
                    if handle and character and character:FindFirstChild("HumanoidRootPart") then
                        if handle.Position.Y < 0 then
                            blacklistedFruits[uniqueId] = true
                            continue
                        end

                        foundFruit = true
                        currentStatusText = "Auto Fruit: " .. obj.Name
                        topos(handle.CFrame)
                        task.wait(0.5)
                        storeAllOwnedFruits()
                        break
                    end
                end
            end
        end
    end)
    return foundFruit
end

local function GetNearbyMob100Studs()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart
    
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    
    for _, enemy in ipairs(enemies:GetChildren()) do
        if enemy.Name == "Jack o' Lantern" then
            local hrp = enemy:FindFirstChild("HumanoidRootPart")
            local hum = enemy:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if (hrp.Position - rootPart.Position).Magnitude <= 100 then
                    return enemy
                end
            end
        end
    end
    return nil
end

local function GetClosestPumpkin()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart
    
    local pumpkinHunt = workspace:FindFirstChild("PumpkinHunt")
    if not pumpkinHunt then return nil end
    
    local closestPart = nil
    local shortestDistance = math.huge
    
    for _, pumpkin in ipairs(pumpkinHunt:GetChildren()) do
        local targetPart = pumpkin:FindFirstChild("HumanoidRootPart") 
            or pumpkin:FindFirstChild("Hitbox") 
            or (pumpkin:IsA("BasePart") and pumpkin) 
            or (pumpkin:IsA("Model") and pumpkin.PrimaryPart)
            
        if targetPart then
            local distance = (rootPart.Position - targetPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestPart = targetPart
            end
        end
    end
    
    return closestPart
end

